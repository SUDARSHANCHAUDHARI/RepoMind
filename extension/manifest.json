{
  "manifest_version": 3,
  "name": "RepoMind AI",
  "version": "1.0.0",
  "description": "Instantly analyze any GitHub repo with AI. Get architecture, features, and a rebuild plan.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://repomind.sudarshantechlabs.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
